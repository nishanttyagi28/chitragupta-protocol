# Copy to .env and fill in real values. Never commit a real .env file --
# it is already excluded in .gitignore.

# Set to 1 ONLY for local development. Disables API/console authentication.
# Do not set this on anything network-reachable.
CHITRAGUPTA_API_DEV_MODE=0

# Required if CHITRAGUPTA_API_DEV_MODE is not "1". Generate a long random
# value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHITRAGUPTA_API_TOKEN=

# Overrides the CLI's default workspace location (.chitragupta).
CHITRAGUPTA_HOME=

# Used only by the Redis test suite to locate a test instance.
REDIS_URL=redis://localhost:6379/0
